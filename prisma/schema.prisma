generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Auth Models ────────────────────────────────────────────────

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String    @unique
  emailVerified            DateTime?
  passwordHash             String?
  image                    String?
  role                     Role      @default(USER)
  credits                  Int       @default(0)
  hasUsedTrial             Boolean   @default(false)
  twoFactorEnabled         Boolean   @default(false)
  twoFactorSecret          String?
  emailTwoFactorEnabled    Boolean   @default(false) // email-code 2FA at login
  // ── Backup recovery codes (last-line 2FA) ──────────────────────
  // Lifetime guard: every backup-code submission at login (right OR wrong)
  // increments recoveryAttempts. At 10 the method is locked forever
  // (recoveryLockedAt) and the user must fall back to another method or a
  // support ticket. Generating a fresh set (authenticated) resets the counter.
  recoveryAttempts         Int       @default(0) // lifetime backup-code submissions
  recoveryLockedAt         DateTime? // set when the 10-attempt cap is hit
  recoveryCodesGeneratedAt DateTime? // when the current set was issued
  canInvite                Boolean   @default(false) // Admin toggle: allows user to generate invite codes
  maxVpcs                  Int       @default(3) // Max VPCs per user (3 default, up to 5 via admin)
  trialExpiresAt           DateTime?
  activePlan               String?
  planActivatedAt          DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  vpnConfigs          VpnConfig[]
  proxyAccounts       ProxyAccount[]
  emailAccounts       EmailAccount[]
  cmsPosts            CmsPost[]
  vpsInstances        VpsInstance[]
  transactions        Transaction[]
  auditLogs           AuditLog[]
  creditTxns          CreditTransaction[]
  appliedPromos       AppliedPromoCode[]
  deploymentTickets   DeploymentTicket[]
  deviceSessions      DeviceSession[]
  emailOtpCodes       EmailOtpCode[]
  recoveryCodes       RecoveryCode[]
  sshKeys             SshKey[]
  nextcloudStorage    UserNextcloudStorage?
  supportChats        SupportChat[]
  tickets             Ticket[]
  ticketNotifications TicketNotification[]
  cryptoTopups        CryptoTopup[]
  invitationCodes     InvitationCode[]      @relation("InviteCreator")
  uploads             FileUpload[]
  wgPeers             WgPeer[]
  vpcs                Vpc[]
  smsRentals          SmsRental[]
  notifications       Notification[]
  vmAlertRules        VmAlertRule[]
  aiConversations     AiConversation[]
  aiSkills            AiSkill[]
  provisioningJobs    ProvisioningJob[]
  mailbox             MailMailbox?

  /// When the user accepted the AI support-chat terms. Null = never consented;
  /// SUPPORT conversations cannot be created until this is set.
  supportChatConsentAt DateTime?

  /// Per-user vanity subdomain label (e.g. "cmabcd12" → cmabcd12.notrespond.com).
  /// First 8 chars of the cuid, extended on the (astronomically rare) prefix
  /// collision. Kept even when Cloudflare fails so a retry is deterministic.
  subdomain       String? @unique @db.VarChar(63)
  /// "PENDING" | "ACTIVE" | "FAILED" — the DNS sweep retries non-ACTIVE rows.
  subdomainStatus String? @db.VarChar(10)
  /// Cloudflare DNS record id, for cleanup on account deletion.
  cfDnsRecordId   String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DeviceSession {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Short-lived email 2FA codes. The 6-digit code is stored bcrypt-hashed and
/// is single-use (consumedAt) with an attempt cap and a 10-minute expiry.
model EmailOtpCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String // bcrypt hash of the 6-digit code
  purpose    String // "login" | "setup"
  attempts   Int       @default(0) // wrong-guess counter (cap then invalidate)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Single-use 2FA backup recovery codes. High-entropy, SHA-256 hashed at rest.
/// Generating a fresh set replaces all prior codes for that user.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // sha256(normalized code)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── SSH Key Management ──────────────────────────────────────────

/// User-owned SSH public keys injected into VMs via cloud-init.
/// Password auth is disabled on all provisioned VMs — key auth only.
model SshKey {
  id        String   @id @default(cuid())
  userId    String
  name      String // e.g. "MacBook Pro", "ePass2003 YubiKey"
  publicKey String   @db.Text // full "ssh-ed25519 AAAA..." string
  isDefault Boolean  @default(false) // injected first during provisioning
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum ServiceType {
  VPS
  EMAIL
  VPN
  PROXY
}

enum OrderStatus {
  PENDING
  PROCESSING
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

model Service {
  id          String      @id @default(cuid())
  name        String
  type        ServiceType
  description String      @db.Text
  price       Decimal     @db.Decimal(10, 2)
  specs       Json?
  stock       Int         @default(-1) // -1 = unlimited
  active      Boolean     @default(true)
  featured    Boolean     @default(false)
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders Order[]
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  serviceId  String
  status     OrderStatus @default(PENDING)
  config     Json?
  totalPrice Decimal     @db.Decimal(10, 2)
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  vpnConfigs    VpnConfig[]
  proxyAccounts ProxyAccount[]
  emailAccounts EmailAccount[]
  vpsInstances  VpsInstance[]

  @@index([userId])
  @@index([serviceId])
}

model VpnConfig {
  id             String   @id @default(cuid())
  userId         String
  orderId        String
  protocol       String // wireguard, openvpn, ikev2
  serverLocation String
  configData     String   @db.LongText // encrypted config file content
  expiresAt      DateTime
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
}

model ProxyAccount {
  id        String   @id @default(cuid())
  userId    String
  orderId   String
  protocol  String // http, socks5, residential
  location  String // country code
  host      String
  port      Int
  username  String
  password  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([location])
}

model EmailAccount {
  id           String   @id @default(cuid())
  userId       String
  orderId      String
  domain       String
  emailAddress String
  serverType   String // postfix, exchange
  status       String   @default("active")
  createdAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
}

// ─── VPS Instance (Proxmox VM Assignment) ───────────────────────

model VpsInstance {
  id          String    @id @default(cuid())
  userId      String
  orderId     String
  vmId        String // Proxmox VM ID (e.g., "104")
  node        String // Proxmox node name (e.g., "pve-01")
  name        String // Display name (e.g., "My Windows VPS")
  os          String // OS label (e.g., "Windows 11 23H2")
  status      String    @default("stopped") // running, stopped, provisioning
  displayType String    @default("novnc") // novnc | spice
  specs       Json? // {vcpu, ram_gb, disk_gb, gpu}
  ciUsername  String? // cloud-init login user (shown on the VM Overview)
  ciPassword  String?   @db.Text // cloud-init password, AES-256-GCM encrypted at rest
  ipAddress   String?
  expiresAt   DateTime?
  ticketId    String?   @unique // Links to DeploymentTicket
  gpuNodeId   String? // Links to GpuNode (null = no GPU)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order                 @relation(fields: [orderId], references: [id])
  ticket        DeploymentTicket?     @relation(fields: [ticketId], references: [id])
  gpuNode       GpuNode?              @relation(fields: [gpuNodeId], references: [id], onDelete: Restrict)
  blockStorage  VmBlockStorageAddon[]
  vpcAssignment VpcAssignment?

  @@unique([vmId, node])
  @@index([userId])
  @@index([gpuNodeId])
}

// ─── GPU Node Inventory ──────────────────────────────────────────

/// Tracks physical GPU hardware available for PCIe passthrough.
/// usedVram is incremented/decremented atomically via Prisma transactions
/// to prevent over-provisioning across concurrent requests.
model GpuNode {
  id         String   @id @default(cuid())
  pciAddress String   @unique // e.g. "0000:03:00.0" or "0000:81:00.0"
  label      String? // human-readable name e.g. "TU106-GPU1-6GB"
  totalVram  Int // allocatable VRAM in GB
  usedVram   Int      @default(0)
  maxVms     Int // hard cap (e.g. 1 for 6GB GPU, 3 for 12GB)
  active     Boolean  @default(true) // set false to drain without deleting
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vms VpsInstance[]

  @@index([active])
}

// ─── AI Inference Nodes (LM Studio) ───────────────────────────────

/// Access tier for an inference node.
/// STANDARD — RX 580 machines, available to every signed-in user.
/// PREMIUM  — RTX 2060 machines, admin-only.
/// The tier is enforced server-side in lib/ai-nodes.ts; the client
/// never decides which node it is allowed to reach.
enum AiTier {
  STANDARD
  PREMIUM
}

// ─── Mail (Postfix/Dovecot on 10.12.0.5) ──────────────────────────
//
// These four tables ARE the mail server's configuration. Postfix and Dovecot
// query them directly over MySQL (user `mailserver`, SELECT-only), so there
// is no sync job and no second source of truth: creating a row here creates
// a working mailbox, and deactivating one stops delivery immediately.
//
// Column names are read by /etc/postfix/mysql-*.cf and dovecot-sql.conf.ext
// on the mail VM — renaming a field here means editing those files too.

enum MailboxKind {
  /// Belongs to a platform user; exactly one per account.
  USER
  /// Send-only or functional box (noreply, support) — admin managed.
  SYSTEM
  /// Receives mail for addresses that have no mailbox yet, so an admin can
  /// be prompted to create one instead of the sender getting a bounce.
  CATCHALL
}

model MailDomain {
  id           String   @id @default(cuid())
  domain       String   @unique
  active       Boolean  @default(true)
  /// When true, only admins may create mailboxes here. notrespond.com is
  /// admin-only; mail.notrespond.com is where users self-serve.
  adminOnly    Boolean  @default(false)
  /// Accept unknown recipients into the catch-all rather than rejecting at
  /// RCPT TO. Turning this off makes the domain bounce unknown addresses.
  catchAll     Boolean  @default(true)
  /// DKIM selector; the private key lives only on the mail VM.
  dkimSelector String   @default("nrsp")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mailboxes MailMailbox[]
  aliases   MailAlias[]
  unrouted  MailUnrouted[]
}

model MailMailbox {
  id           String      @id @default(cuid())
  /// Null for SYSTEM/CATCHALL boxes. Unique so a user can hold at most one
  /// mailbox — MySQL permits many NULLs under a unique index, which is
  /// exactly the "one per user, unlimited system boxes" rule we want.
  userId       String?     @unique
  domainId     String
  localPart    String      @db.VarChar(64)
  /// Denormalised "localPart@domain" — Postfix looks up this single column.
  address      String      @unique @db.VarChar(255)
  /// bcrypt hash, read by Dovecot as BLF-CRYPT (same scheme as User.passwordHash).
  passwordHash String      @db.Text
  quotaMb      Int         @default(1024)
  active       Boolean     @default(true)
  kind         MailboxKind @default(USER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastLoginAt  DateTime?

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain MailDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, localPart])
  @@index([active])
}

model MailAlias {
  id          String   @id @default(cuid())
  domainId    String
  /// "sales@domain" or "@domain" for a catch-all.
  source      String   @unique @db.VarChar(255)
  /// Comma-separated target addresses, as Postfix expects.
  destination String   @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  domain MailDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

/// An address that received mail while having no mailbox. Written by the
/// catch-all reporter on the mail VM; drives the admin's "create an inbox
/// for this address?" prompt.
model MailUnrouted {
  id           String    @id @default(cuid())
  domainId     String
  recipient    String    @db.VarChar(255)
  lastSender   String?   @db.VarChar(255)
  lastSubject  String?   @db.VarChar(255)
  messageCount Int       @default(1)
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  /// Set once an admin creates the mailbox or dismisses the prompt.
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?

  domain MailDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([recipient])
  @@index([resolved, lastSeenAt])
}

// ─── n8n-orchestrated VM provisioning ─────────────────────────────

enum ProvisioningJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  COMPENSATED
  TIMED_OUT
}

/// One VM provisioning run, orchestrated step-by-step (normally by n8n,
/// inline as fallback). Money moves BEFORE the job is dispatched — the job
/// only ever moves hypervisor state; `compensate` refunds via the recorded
/// charge fields when a run dies half-way.
model ProvisioningJob {
  id             String                @id @default(cuid())
  userId         String
  status         ProvisioningJobStatus @default(QUEUED)
  /// Step currently executing (or last executed) — for the UI checklist.
  currentStep    String?               @db.VarChar(16)
  /// [{step, ok, ms, at, detail?}] appended by every step call.
  stepLog        Json
  planId         String
  templateId     String
  /// vmName, ciuser, ciPasswordEnc (AES-256-GCM), sshKeys, templateName,
  /// knownVmid, family, chargedCredits, ticketWasPreexisting…
  params         Json
  /// Dedup key — a replayed n8n webhook or step call cannot double-clone.
  idempotencyKey String                @unique
  orderId        String?
  ticketId       String?
  /// Set after the clone step; required for compensation to know what to destroy.
  vmId           Int?
  node           String?
  vpsInstanceId  String?               @unique
  error          String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt]) // timeout sweep
}

/// Which wire protocol a node speaks. The chat route selects an adapter from
/// this rather than sniffing baseUrl, so adding a provider is a new adapter
/// plus a new enum value — never a branch inside the transport.
///
/// LOCAL     — OpenAI-compatible HTTP (LM Studio, vLLM, Ollama). Private LAN.
/// ANTHROPIC — Claude via the official SDK. Server-side sandbox available.
/// GOOGLE    — Gemini via @google/genai.
/// OPENAI    — reserved; the LOCAL adapter already speaks this wire format,
///             but a hosted key has different cost and egress properties and
///             deserves its own tier gate rather than masquerading as local.
enum AiProviderKind {
  LOCAL
  ANTHROPIC
  GOOGLE
  OPENAI
  /// DeepSeek's hosted API. Speaks the OpenAI wire format, so it runs through
  /// the same adapter as a local LM Studio host — it differs by needing a key
  /// and by living at a fixed endpoint rather than on the LAN.
  DEEPSEEK
}

/// One addressable model endpoint.
///
/// Originally an LM Studio host; now any provider. LOCAL nodes sit on the
/// private LAN and are never reachable from the browser. Hosted providers
/// (ANTHROPIC/GOOGLE/OPENAI) bill per token against the operator's key, so
/// they default to PREMIUM — an unmetered public model would be a bill, not
/// a feature. All traffic is proxied through /api/ai/chat either way, so the
/// tier gate cannot be bypassed and keys never reach the client.
model AiNode {
  id               String         @id @default(cuid())
  name             String         @unique // "lm-rx580-01"
  displayName      String // "Qwen2.5 14B — RX 580 #1"
  /// Hardware label for LOCAL nodes ("RX 580 8GB"); for hosted providers this
  /// carries the vendor name so the UI has one field to show either way.
  gpuLabel         String
  provider         AiProviderKind @default(LOCAL)
  tier             AiTier         @default(STANDARD)
  /// Required for LOCAL (the OpenAI-compatible endpoint). Optional for hosted
  /// providers, where the SDK knows its own default — set it only to point at
  /// a proxy or a region-specific endpoint.
  baseUrl          String?
  apiKey           String?        @db.Text // AES-256-GCM encrypted; LM Studio usually needs none
  /// Encrypted OAuth refresh token, set only when the node authenticates with
  /// a Claude subscription. Never returned by any route — not even to an admin,
  /// who already holds the access token the browser needed.
  refreshToken     String?        @db.Text
  /// Expiry of the current subscription access token. Null for API keys, which
  /// do not expire. Without this a subscription node goes green, works for a
  /// few hours, then starts failing 401 with nothing explaining why.
  tokenExpiresAt   DateTime?
  modelId          String // "qwen2.5-14b" | "claude-opus-5" | "gemini-2.5-pro"
  /// Let the provider run code in its own hosted sandbox when a task needs it.
  /// ANTHROPIC only today (code_execution server tool). Off by default: it is
  /// billed compute and an execution surface, so it is opt-in per node.
  serverSandbox    Boolean        @default(false)
  /// Allow the provider's hosted web search / fetch tools. Egress on the
  /// provider's side, not ours — separate switch from the sandbox.
  serverWebAccess  Boolean        @default(false)
  contextLen       Int            @default(8192)
  maxTokens        Int            @default(2048)
  /// True when the runtime actually honours reasoning_effort. Verified per
  /// node — LM Studio silently ignores it for some models (gemma-4 QAT), and
  /// shipping a control that does nothing is worse than not offering it.
  reasoningControl Boolean        @default(false)
  /// Embedding model loaded on this host, if any. Retrieval uses the node the
  /// user is already entitled to, so embedding never crosses a tier boundary.
  embedModelId     String?
  active           Boolean        @default(true)
  online           Boolean        @default(false)
  lastError        String?        @db.Text
  lastCheckAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  conversations AiConversation[]

  @@index([tier, active])
}

/// What a conversation is for. The server derives every privilege from this —
/// SUPPORT threads get the restricted support prompt, PUBLIC-only retrieval
/// and the STANDARD node regardless of the caller's role. Never client-flippable
/// after creation.
enum ConversationKind {
  STUDIO
  SUPPORT
}

model AiConversation {
  id              String           @id @default(cuid())
  userId          String
  nodeId          String?
  /// Model chosen on that node for this thread. Null means the node's default.
  /// A node is a machine, and one machine often serves several models.
  modelId         String?          @db.VarChar(160)
  kind            ConversationKind @default(STUDIO)
  title           String           @default("New chat") @db.VarChar(200)
  /// Display preference for a reasoning model's scratchpad. Always effective,
  /// because it is applied on our side rather than asked of the runtime.
  showReasoning   Boolean          @default(true)
  /// "off" | "low" | "medium" | "high". Only sent upstream when the node's
  /// reasoningControl is true; otherwise recorded but not acted on.
  reasoningEffort String?          @db.VarChar(8)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  node     AiNode?               @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  messages AiMessage[]
  skills   AiConversationSkill[]

  @@index([userId, updatedAt])
  @@index([nodeId])
}

// ─── AI Knowledge Base (RAG) ──────────────────────────────────────

/// Who may retrieve a document. Enforced at query time, not at render time —
/// a STANDARD user's retrieval never reads ADMIN rows, so infra detail cannot
/// leak through a summarised answer.
enum AiDocVisibility {
  PUBLIC
  ADMIN
}

/// A curated infrastructure document the assistant can ground answers on.
/// Content is authored by admins only. Never store secrets here: everything
/// in a PUBLIC doc should be considered readable by any signed-in user, and
/// everything in any doc should be considered reachable by a prompt injection.
model AiKnowledgeDoc {
  id         String          @id @default(cuid())
  slug       String          @unique
  title      String
  /// "topology" | "web-guide" | "machine-guide" | "security" | "runbook"
  category   String
  content    String          @db.LongText
  visibility AiDocVisibility @default(ADMIN)
  published  Boolean         @default(false)
  /// Where the text came from, for provenance in citations.
  source     String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  chunks AiKnowledgeChunk[]

  @@index([published, visibility])
  @@index([category])
}

/// One retrievable slice of a document plus its embedding vector.
/// The vector is stored as a JSON float array — the corpus is small enough
/// that in-process cosine scoring beats adding a vector database.
model AiKnowledgeChunk {
  id        String   @id @default(cuid())
  docId     String
  ordinal   Int
  content   String   @db.Text
  embedding String   @db.LongText
  dims      Int      @default(768)
  createdAt DateTime @default(now())

  doc AiKnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, ordinal])
}

// ─── User-defined skills ──────────────────────────────────────────

/// A named instruction block the user can switch on for a conversation.
///
/// Deliberately provider-neutral: a skill is text (plus optional reference
/// files) that gets composed into the system prompt, so it behaves identically
/// on a local model, Claude, and Gemini. Anthropic's own Skills format is
/// richer but Claude-only, which would make the same skill act differently
/// depending on which model the user picked.
///
/// Skill text is authored by the owning user and is NOT privileged: it is
/// composed into the system prompt but can never grant a tool or raise a tier.
/// Treat it as user input that the model reads, not as operator instruction.
model AiSkill {
  id           String   @id @default(cuid())
  userId       String
  name         String   @db.VarChar(80)
  description  String?  @db.VarChar(300)
  /// The instruction text composed into the system prompt when enabled.
  instructions String   @db.LongText
  /// Shared skills are visible to every user; only an admin may publish one.
  shared       Boolean  @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  files AiSkillFile[]
  uses  AiConversationSkill[]

  @@unique([userId, name])
  @@index([shared, enabled])
}

/// A reference file attached to a skill. Content is stored inline rather than
/// on disk so a skill is a single portable row-set, and because these are
/// prompt fragments (documentation, schemas, style guides) rather than blobs.
model AiSkillFile {
  id        String   @id @default(cuid())
  skillId   String
  filename  String   @db.VarChar(200)
  mimeType  String   @db.VarChar(100)
  /// Extracted text. Binary uploads are converted at ingest; anything that
  /// cannot be represented as text is rejected rather than stored unusable.
  content   String   @db.LongText
  bytes     Int
  createdAt DateTime @default(now())

  skill AiSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

/// Join row — which skills are active for a conversation.
model AiConversationSkill {
  conversationId String
  skillId        String
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  skill        AiSkill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([conversationId, skillId])
  @@index([skillId])
}

model AiMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant" | "system"
  content        String          @db.LongText
  modelId        String? // snapshot — the node may be re-pointed later
  gpuLabel       String?
  /// Which provider produced this turn. Null on user turns and on rows written
  /// before multi-model conversations existed.
  provider       AiProviderKind?
  /// Human name of the model that produced it ("Claude Opus 5"), snapshotted so
  /// the transcript stays readable after a node is renamed or deleted.
  speaker        String?         @db.VarChar(80)
  promptTokens   Int?
  outputTokens   Int?
  latencyMs      Int?
  failed         Boolean         @default(false)
  createdAt      DateTime        @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Phase 1: Proxmox VM Block Storage Addons ──────────────────────

/// Tracks extra Proxmox block disk volumes attached to a specific VM.
/// Provisioned via Proxmox API (equivalent to `qm set <vmid> --scsiN pool:sizeG`).
/// Pricing: NVME 2000 VND/GB • SATA 1200 VND/GB • HDD 350 VND/GB
model VmBlockStorageAddon {
  id            String   @id @default(cuid())
  vpsInstanceId String
  storagePool   String // Proxmox pool name e.g. "SSD-NVME-2TB", "local-zfs"
  storageType   String // "nvme" | "sata" | "hdd" (tier classification)
  diskSlot      String // e.g. "sata1", "scsi1" (bus:index assigned)
  sizeGb        Int // GB attached in this transaction
  pricePerGb    Int // VND/GB snapshot at purchase time
  totalCost     Int // sizeGb × pricePerGb
  active        Boolean  @default(true)
  purchasedAt   DateTime @default(now())

  vpsInstance VpsInstance @relation(fields: [vpsInstanceId], references: [id], onDelete: Cascade)

  @@index([vpsInstanceId])
}

// ─── Per-Customer Virtual Private Cloud ──────────────────────────

/// Tracks isolated VPC networks with per-customer VLANs (501-1000).
/// Each VPC maps to a Proxmox SDN VNet and a MikroTik VLAN interface.
/// /28 subnets provide 14 usable IPs per customer.
/// Users can self-provision up to maxVpcs (default 3, max 5).
model Vpc {
  id             String   @id @default(cuid())
  userId         String? // Owner — null for legacy admin-created VPCs
  name           String // User-chosen display name
  vlanId         Int      @unique // Per-user 802.1Q VLAN tag (1001-2000)
  networkId      String? // 8-hex hash label of the owner id (per /28)
  networkIndex   Int?     @unique // /28 block index in 10.50.0.0/16 (0-4095)
  vnetName       String   @unique // Proxmox SDN VNet name (e.g. "vc1001")
  zoneName       String   @default("NRSPVC") // Proxmox SDN Zone (VLAN type)
  mikrotikVlanIf String? // MikroTik per-user VLAN interface (e.g. "vlan1001-cust")
  subnet         String   @unique // "10.50.3.16/28" — one /28 per VPC
  gateway        String // "10.50.3.17"
  dhcpStart      String? // "10.50.3.18"
  dhcpEnd        String? // "10.50.3.30"
  isolate        Boolean  @default(true) // Proxmox "Isolate Ports"
  status         String   @default("ACTIVE") // ACTIVE | DISABLED
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments VpcAssignment[]

  @@index([userId])
  @@index([vlanId])
  @@index([networkIndex])
  @@index([status])
}

/// Links a VPS instance to a VPC. 1:1 relationship — each VM
/// belongs to at most one VPC at a time.
model VpcAssignment {
  id            String   @id @default(cuid())
  vpcId         String
  vpsInstanceId String   @unique // 1:1 — one VM per VPC assignment
  bridgeName    String // Proxmox bridge assigned (e.g. "vc001")
  ipAddress     String? // Resolved IP within the /28 (auto or manual)
  dhcp          Boolean  @default(true) // true = auto-assign, false = manual static
  assignedAt    DateTime @default(now())

  vpc         Vpc         @relation(fields: [vpcId], references: [id], onDelete: Cascade)
  vpsInstance VpsInstance @relation(fields: [vpsInstanceId], references: [id], onDelete: Cascade)

  @@index([vpcId])
}

// ─── Website-Managed WireGuard Peers ─────────────────────────────

/// Tracks WireGuard peers created via the website dashboard.
/// Peers are pushed to the MikroTik Customers-WG1 interface.
/// Each user can have up to 3 active peers (phone, laptop, desktop).
/// Remote-WG1 is never managed by the website.
model WgPeer {
  id             String    @id @default(cuid())
  userId         String
  name           String // "My Laptop", "iPhone"
  publicKey      String    @unique // Client WG public key
  presharedKey   String?   @db.Text // Optional PSK
  assignedIp     String    @unique // 10.98.0.x
  allowedSubnets String    @db.Text // JSON: ["10.50.1.0/28"]
  mikrotikPeerId String? // MikroTik .id for deletion
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Phase 2: Per-User Nextcloud Cloud Storage ─────────────────────

/// One record per user. Tracks their Nextcloud cloud storage quota.
/// Rules:
///   - 5 GB free base (granted when first eligible VM is provisioned)
///   - Paid expansion: must be in 5 GB increments (5, 10, 15 … 95 GB extra)
///   - Hard cap: 100 GB total (5 GB free + up to 95 GB paid)
///   - Prerequisite: user must have ≥1 active VpsInstance (min. Nano-NAT tier)
model UserNextcloudStorage {
  id            String   @id @default(cuid())
  userId        String   @unique
  ncUsername    String   @unique // NC account name; convention: "user-<userId[0..7]>"
  freeGb        Int      @default(5) // base free tier
  paidGb        Int      @default(0) // total paid expansion GB
  totalGb       Int      @default(5) // freeGb + paidGb (denormalised for fast reads)
  active        Boolean  @default(true)
  provisionedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ncUsername])
}

// ─── CMS Models ─────────────────────────────────────────────────

enum CmsType {
