generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Auth Models ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  credits       Int       @default(0)
  hasUsedTrial  Boolean   @default(false)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  trialExpiresAt DateTime?
  activePlan    String?
  planActivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  vpnConfigs    VpnConfig[]
  proxyAccounts ProxyAccount[]
  emailAccounts EmailAccount[]
  blogPosts     BlogPost[]
  vpsInstances  VpsInstance[]
  transactions  Transaction[]
  activityLogs  ActivityLog[]
  creditTxns    CreditTransaction[]
  appliedPromos AppliedPromoCode[]
  deploymentTickets DeploymentTicket[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Business Models ────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum ServiceType {
  VPS
  EMAIL
  VPN
  PROXY
}

enum OrderStatus {
  PENDING
  PROCESSING
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

model Service {
  id          String      @id @default(cuid())
  name        String
  type        ServiceType
  description String      @db.Text
  price       Decimal     @db.Decimal(10, 2)
  specs       Json?
  stock       Int         @default(-1) // -1 = unlimited
  active      Boolean     @default(true)
  featured    Boolean     @default(false)
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders Order[]
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  serviceId  String
  status     OrderStatus @default(PENDING)
  config     Json?
  totalPrice Decimal     @db.Decimal(10, 2)
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  vpnConfigs    VpnConfig[]
  proxyAccounts ProxyAccount[]
  emailAccounts EmailAccount[]
  vpsInstances  VpsInstance[]

  @@index([userId])
  @@index([serviceId])
}

model VpnConfig {
  id             String   @id @default(cuid())
  userId         String
  orderId        String
  protocol       String   // wireguard, openvpn, ikev2
  serverLocation String
  configData     String   @db.LongText // encrypted config file content
  expiresAt      DateTime
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
}

model ProxyAccount {
  id       String  @id @default(cuid())
  userId   String
  orderId  String
  protocol String  // http, socks5, residential
  location String  // country code
  host     String
  port     Int
  username String
  password String
  active   Boolean @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([location])
}

model EmailAccount {
  id           String   @id @default(cuid())
  userId       String
  orderId      String
  domain       String
  emailAddress String
  serverType   String   // postfix, exchange
  status       String   @default("active")
  createdAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
}

// ─── VPS Instance (Proxmox VM Assignment) ───────────────────────

model VpsInstance {
  id             String    @id @default(cuid())
  userId         String
  orderId        String
  vmId           String    // Proxmox VM ID (e.g., "104")
  node           String    // Proxmox node name (e.g., "pve-01")
  name           String    // Display name (e.g., "My Windows VPS")
  os             String    // OS label (e.g., "Windows 11 23H2")
  status         String    @default("stopped") // running, stopped, provisioning
  specs          Json?     // {vcpu, ram_gb, disk_gb, gpu}
  ipAddress      String?
  expiresAt      DateTime?
  ticketId       String?   @unique  // Links to DeploymentTicket
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order             @relation(fields: [orderId], references: [id])
  ticket DeploymentTicket? @relation(fields: [ticketId], references: [id])

  @@unique([vmId, node])
  @@index([userId])
}

// ─── Blog Models ────────────────────────────────────────────────

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?  @db.Text
  content    String   @db.LongText
  coverImage String?
  published  Boolean  @default(false)
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([published])
}

// ─── Billing & Transactions ────────────────────────────────

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  method    String   @default("dev_bypass") // btc, eth, dev_bypass
  status    String   @default("paid")       // paid, pending, failed
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Activity Log ─────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // e.g., "VM Created", "Login Success"
  service   String   // e.g., "Compute", "Auth", "Billing"
  status    String   // e.g., "Success", "Failed"
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ─── Credit Wallet ────────────────────────────────────────────────

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "Top-up", "VM_Deduction", "Promo_Redeem"
  amount    Int      // positive = credit, negative = deduction
  details   String?  // e.g. "VM#101 Deduction", "Promo: LAUNCH25"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  creditValue  Int
  maxUses      Int       @default(1)
  currentUses  Int       @default(0)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  appliedToUsers AppliedPromoCode[]
}

model AppliedPromoCode {
  id          String   @id @default(cuid())
  userId      String
  promoCodeId String
  appliedAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])

  @@unique([userId, promoCodeId])
  @@index([userId])
}

// ─── Deployment Ticket System ─────────────────────────────────────

model DeploymentTicket {
  id         String    @id @default(cuid())
  userId     String
  planId     String    // e.g., "Dev-Standard", "Perform-NVMe"
  status     String    @default("AVAILABLE") // "AVAILABLE" | "IN_USE"
  validUntil DateTime
  createdAt  DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpsInstance VpsInstance? // populated when status = "IN_USE"

  @@index([userId])
  @@index([status])
}

