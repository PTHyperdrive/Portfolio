// ─── ISO 27001 A.12.4 — Immutable Audit Logging ─────────────────

enum AuditAction {
  // Auth
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ACCOUNT_CREATED
  TFA_ENABLED
  TFA_DISABLED
  TFA_RECOVERY_GENERATED
  TFA_RECOVERY_USED
  TFA_RECOVERY_LOCKED
  TFA_LOCKOUT_TICKET
  PASSWORD_CHANGED
  SESSION_REVOKED
  // VM Lifecycle
  VM_CREATE
  VM_START
  VM_STOP
  VM_REBOOT
  VM_DESTROY
  VM_REINSTALL
  VM_RESIZE
  VM_DISPLAY_CHANGE
  VM_GPU_ALLOCATE
  VM_GPU_RELEASE
  // Console Access
  CONSOLE_VNC_ACCESS
  CONSOLE_SPICE_ACCESS
  // Billing
  CREDIT_TOPUP
  CREDIT_DEDUCTION
  PROMO_APPLIED
  PLAN_ACTIVATED
  STORAGE_PURCHASE
  // Orchestration
  SNAPSHOT_CREATE
  SNAPSHOT_DELETE
  SNAPSHOT_ROLLBACK
  BACKUP_CREATE
  // Admin
  ADMIN_USER_MODIFY
  ADMIN_VM_ASSIGN
  ADMIN_VM_MODIFY
  ADMIN_PASSWORD_RESET
  ADMIN_USER_DELETE
  ADMIN_PRICING_CHANGE
  // Data
  DATA_EXPORT
  DATA_DELETION_REQUEST
  USER_ANONYMIZED
  // Security
  SSH_KEY_ADD
  SSH_KEY_REMOVE
  // Crypto Payments
  CRYPTO_TOPUP_INITIATED
  CRYPTO_TOPUP_COMPLETED
  // Invitation System
  INVITE_CODE_GENERATED
  INVITE_CODE_REDEEMED
  INVITE_PERMISSION_CHANGED
  // Chat
  ADMIN_CHAT_CLOSED
  ADMIN_PIN_RESET
  ADMIN_CHAT_KEY_SETUP
  USER_CHAT_PIN_RESET
  // VPC / Network
  VPC_CREATE
  VPC_DELETE
  VPC_ASSIGN_VM
  VPC_UNASSIGN_VM
  // WireGuard
  WG_PEER_CREATE
  WG_PEER_REVOKE
  // TimoSMS — temporary SMS rental
  SMS_RENT
  SMS_CANCEL
  SMS_CODE_RECEIVED
  SMS_SERVICE_MODIFY
  // Monitoring
  ALERT_FIRED
  // Misc
  REDIRECT_TO_PLANS
  TRIGGER_UPSELL_FLOW
  // AI Inference (LM Studio)
  AI_CHAT_COMPLETION
  AI_TIER_DENIED
  AI_CONVERSATION_DELETE
  ADMIN_AI_NODE_MODIFY
  // AI tool use / retrieval
  AI_TOOL_CALL
  AI_TOOL_DENIED
  AI_KNOWLEDGE_SEARCH
  ADMIN_AI_DOC_MODIFY
  // Claude Code relay — a terminal on the operator's own machine is the most
  // privileged surface here, so every attach is recorded.
  ADMIN_RELAY_ATTACH
  // Successful TOTP entry at the unlisted vault page.
  ADMIN_VAULT_LOGIN
  // User-authored skills
  AI_SKILL_CREATE
  AI_SKILL_UPDATE
  AI_SKILL_DELETE
  // AI support bubble
  SUPPORT_CHAT_CONSENT
  // Per-user subdomains
  SUBDOMAIN_PROVISIONED
  // Mail
  MAILBOX_CREATE
  MAILBOX_DELETE
  MAILBOX_PASSWORD_RESET
  MAILBOX_ADMIN_ACCESS
  MAIL_MESSAGE_DELETE
  MAIL_ATTACHMENT_DOWNLOAD
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String
  action       AuditAction
  resourceType String // "VirtualMachine", "UserAccount", "Network", "Billing"
  resourceId   String? // ID of the target resource (vmId, orderId, etc.)
  ipAddress    String?
  userAgent    String?
  metadata     Json? // Payload diffs, extra context
  outcome      String      @default("SUCCESS") // "SUCCESS" | "FAILED" | "DENIED"
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ─── Credit Wallet ────────────────────────────────────────────────

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  type      String // "Top-up", "VM_Deduction", "Promo_Redeem"
  amount    Int // positive = credit, negative = deduction
  details   String? // e.g. "VM#101 Deduction", "Promo: LAUNCH25"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  creditValue Int
  maxUses     Int       @default(1)
  currentUses Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  appliedToUsers AppliedPromoCode[]
}

model AppliedPromoCode {
  id          String   @id @default(cuid())
  userId      String
  promoCodeId String
  appliedAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])

  @@unique([userId, promoCodeId])
  @@index([userId])
}

// ─── Deployment Ticket System ─────────────────────────────────────

model DeploymentTicket {
  id         String   @id @default(cuid())
  userId     String
  planId     String // e.g., "Dev-Standard", "Perform-NVMe"
  status     String   @default("AVAILABLE") // "AVAILABLE" | "IN_USE"
  validUntil DateTime
  createdAt  DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpsInstance VpsInstance? // populated when status = "IN_USE"

  @@index([userId])
  @@index([status])
}

// ─── MMO Digital Asset Storefront ────────────────────────────────

/// A category of digital products (e.g., "Netflix Accounts", "Gmail Aged")
/// `schema` stores pipe-delimited field names that define each item's structure.
model MmoProductCategory {
  id           String   @id @default(cuid())
  slug         String   @unique // URL-safe: "netflix-premium"
  name         String // Display: "Netflix Premium Accounts"
  description  String?  @db.Text
  imageUrl     String? // Product card image URL
  schema       String   @db.Text // "email|password|recovery|2fa"
  pricePerUnit Int // price in Credits per unit
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items MmoInventoryItem[]

  @@index([active])
}

/// Individual inventory records stocked by Admin.
/// `data` stores pipe-delimited values matching the category schema.
/// 30-day retention: data is viewable until expiresAt, then purged.
model MmoInventoryItem {
  id         String    @id @default(cuid())
  categoryId String
  data       String    @db.Text // "user@ex.com|Pass123!|recov@x.com|TOTP"
  sold       Boolean   @default(false)
  soldAt     DateTime?
  soldToId   String? // userId of buyer (null = unsold)
  expiresAt  DateTime? // soldAt + 30 days; null = unsold
  createdAt  DateTime  @default(now())

  category MmoProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sold])
  @@index([soldToId])
  @@index([expiresAt])
}

// ─── Secure E2EE Support Chat ────────────────────────────────────

// ─── Secure E2EE Support Chat ────────────────────────────────────

/// Per-user encrypted chat thread for admin support.
/// Uses ECDH P-256 key agreement: user + admin each have a keypair.
/// Private keys are stored encrypted with their respective PINs.
/// PINs are local UI locks only — NOT the message encryption key.
model SupportChat {
  id             String    @id @default(cuid())
  userId         String
  userPubKey     String    @db.Text // User's ECDH public key (JWK JSON)
  userEncPrivKey String    @db.Text // User's private key encrypted with user PIN (base64)
  userKeyIv      String // IV used to encrypt user's private key (base64)
  pinHash        String // bcrypt hash of user-chosen PIN
  closed         Boolean   @default(false)
  closedAt       DateTime? // Timestamp when permanently closed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@unique([userId]) // one active chat per user
  @@index([userId])
}

/// Individual encrypted messages within a support chat.
/// `ciphertext` is AES-GCM encrypted payload (base64).
/// `iv` is the initialization vector used for AES-GCM (base64).
/// `senderType` distinguishes USER vs ADMIN messages.
model SupportMessage {
  id         String   @id @default(cuid())
  chatId     String
  senderType String // "USER" | "ADMIN"
  ciphertext String   @db.Text // AES-GCM encrypted message (base64)
  iv         String // AES-GCM IV (base64)
  createdAt  DateTime @default(now())

  chat SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

// ─── Global Ticket System ────────────────────────────────────────

enum TicketStatus {
  PENDING
  UNSOLVED
  SOLVED
}

/// Platform-wide support tickets. Supports markdown descriptions
/// and secure image evidence uploads. Viewable only by the
/// creator and platform administrators.
model Ticket {
  id          String       @id @default(cuid())
  userId      String
  title       String       @db.VarChar(200)
  description String       @db.Text // Markdown body
  imageUrls   String?      @db.Text // JSON array of upload paths
  status      TicketStatus @default(PENDING)
  priority    String       @default("medium") // low | medium | high | critical
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications TicketNotification[]

  @@index([userId, status])
  @@index([status, createdAt])
}

/// In-app notification sent when an admin changes a ticket to SOLVED.
model TicketNotification {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String // The ticket creator who receives the notification
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([ticketId])
}

/// Global platform configuration key-value store.
/// Used by the admin System Settings panel.
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── Crypto Top-up (Shkeeper.io USDT Gateway) ────────────────────

/// Tracks each crypto top-up request lifecycle.
/// HD wallet derivation ensures every address is unique and non-reusable.
model CryptoTopup {
  id              String    @id @default(cuid())
  userId          String
  amountUsdt      Decimal   @db.Decimal(12, 6)
  creditAmount    Int // Calculated credits to mint (amountUsdt * exchange rate)
  chain           String // "TRC20" | "ERC20"
  depositAddress  String // Unique HD-derived address for this top-up
  derivationIndex Int // HD wallet derivation path index
  txHash          String? // Blockchain transaction hash (set on confirmation)
  confirmations   Int       @default(0)
  status          String    @default("PENDING") // PENDING | CONFIRMING | COMPLETED | EXPIRED
  expiresAt       DateTime // Address validity window (e.g., 30 minutes)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([depositAddress])
  @@index([status])
}

// ─── Invitation Code System ──────────────────────────────────────

/// User-generated invitation codes for trial access.
/// Only users with canInvite = true can generate codes.
/// Each code supports up to maxUses redemptions (default 10).
model InvitationCode {
  id        String    @id @default(cuid())
  code      String    @unique // Format: "NRSP-XXXX-XXXX"
  creatorId String // User who generated the code
  maxUses   Int       @default(10) // Max redemptions per code
  usedCount Int       @default(0) // Current redemption count
  expiresAt DateTime? // Optional expiry
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  creator     User                   @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  redemptions InvitationRedemption[]

  @@index([code])
  @@index([creatorId])
}

/// Tracks each individual redemption of an invitation code.
model InvitationRedemption {
  id               String   @id @default(cuid())
  invitationCodeId String
  userId           String // User who redeemed the code
  redeemedAt       DateTime @default(now())
  context          String   @default("REGISTRATION") // "REGISTRATION" | "CHECKOUT"

  invitationCode InvitationCode @relation(fields: [invitationCodeId], references: [id], onDelete: Cascade)

  @@unique([invitationCodeId, userId]) // One redemption per user per code
  @@index([userId])
}

// ─── TimoSMS — Temporary SMS-Receive Rental ──────────────────────

enum SmsRentalStatus {
  WAITING // number issued, awaiting an inbound SMS
  RECEIVED // a valid code was delivered AND charged
  CANCELLED // user cancelled before any code
  EXPIRED // TTL elapsed with no code (never charged)
  ERROR // provider/allocation failure
}

/// A rentable target service (e.g. Google, Telegram) for a given country.
/// Price is in prepaid credits (1 Credit = 1 VND); USD shown via exchange rate.
/// `providerServiceCode` maps to the Telecom API's own service identifier.
model SmsService {
  id                  String   @id @default(cuid())
  code                String // slug, e.g. "google"
  name                String // display, e.g. "Google / Gmail"
  country             String   @default("VN") // ISO country of the numbers
  priceCredits        Int // charged once a code is received
  providerServiceCode String? // Telecom API service id
  iconUrl             String?
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  rentals SmsRental[]

  @@unique([code, country])
  @@index([active, sortOrder])
}

/// One rent-a-number transaction. Billing is charge-on-receipt: credits are
/// only deducted when a valid code is delivered (status RECEIVED). The code is
/// withheld until the charge succeeds. No charge on CANCELLED/EXPIRED.
model SmsRental {
  id               String          @id @default(cuid())
  userId           String
  serviceId        String
  providerRentalId String? // Telecom API rental/activation id
  phoneNumber      String?
  country          String
  status           SmsRentalStatus @default(WAITING)
  priceCredits     Int // snapshot of service price at rent time
  code             String? // revealed only when charged
  charged          Boolean         @default(false)
  createdAt        DateTime        @default(now())
  expiresAt        DateTime // TTL — auto-expires if no code
  completedAt      DateTime?
  cancelledAt      DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service  SmsService   @relation(fields: [serviceId], references: [id])
  messages SmsMessage[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

/// Raw inbound SMS messages for a rental. A rental may receive several; the
/// extracted OTP (if any) is stored on both the message and the rental.
model SmsMessage {
  id         String   @id @default(cuid())
  rentalId   String
  sender     String?
  text       String   @db.Text
  code       String?
  receivedAt DateTime @default(now())

  rental SmsRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
}

// ─── Monitoring & Alerts ─────────────────────────────────────────

/// In-app notification (system/alert). Separate from TicketNotification so the
/// bell can surface monitoring alerts alongside ticket updates.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("system") // "alert" | "system"
  title     String
  body      String   @db.Text
  link      String? // optional in-app deep link
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// A user-defined threshold alert on one VM metric. The monitoring sweep
/// evaluates enabled rules and fires a Notification (+ email) on breach,
/// rate-limited by lastFiredAt. `lastValue`/`lastValueAt` hold the previous
/// sample so bandwidth (a rate) can be derived between sweeps.
model VmAlertRule {
  id          String    @id @default(cuid())
  userId      String
  vmId        String // Proxmox VMID
  node        String
  metric      String // "cpu" | "mem" | "disk" | "bandwidth"
  comparison  String    @default("gt") // "gt" | "lt"
  threshold   Float // percent (cpu/mem/disk) or Mbps (bandwidth)
  enabled     Boolean   @default(true)
  lastValue   Float? // prior sample (bandwidth: cumulative bytes)
  lastValueAt DateTime?
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, vmId, metric])
  @@index([enabled])
}
