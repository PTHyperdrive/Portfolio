generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Auth Models ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  credits       Int       @default(0)
  hasUsedTrial  Boolean   @default(false)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  loginWith2FA     Boolean @default(false)
  canInvite     Boolean   @default(false) // Admin toggle: allows user to generate invite codes
  maxVpcs       Int       @default(3)    // Max VPCs per user (3 default, up to 5 via admin)
  trialExpiresAt DateTime?
  activePlan    String?
  planActivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  orders            Order[]
  vpnConfigs        VpnConfig[]
  proxyAccounts     ProxyAccount[]
  emailAccounts     EmailAccount[]
  cmsPosts         CmsPost[]
  vpsInstances      VpsInstance[]
  transactions      Transaction[]
  auditLogs         AuditLog[]
  creditTxns        CreditTransaction[]
  appliedPromos     AppliedPromoCode[]
  deploymentTickets DeploymentTicket[]
  deviceSessions    DeviceSession[]
  sshKeys              SshKey[]
  nextcloudStorage     UserNextcloudStorage?
  supportChats         SupportChat[]
  tickets              Ticket[]
  ticketNotifications  TicketNotification[]
  cryptoTopups         CryptoTopup[]
  invitationCodes      InvitationCode[]     @relation("InviteCreator")
  uploads              FileUpload[]
  wgPeers              WgPeer[]
  vpcs                 Vpc[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DeviceSession {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── SSH Key Management ──────────────────────────────────────────

/// User-owned SSH public keys injected into VMs via cloud-init.
/// Password auth is disabled on all provisioned VMs — key auth only.
model SshKey {
  id        String   @id @default(cuid())
  userId    String
  name      String   // e.g. "MacBook Pro", "ePass2003 YubiKey"
  publicKey String   @db.Text // full "ssh-ed25519 AAAA..." string
  isDefault Boolean  @default(false) // injected first during provisioning
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


enum Role {
  USER
  ADMIN
}

enum ServiceType {
  VPS
  EMAIL
  VPN
  PROXY
}

enum OrderStatus {
  PENDING
  PROCESSING
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

model Service {
  id          String      @id @default(cuid())
  name        String
  type        ServiceType
  description String      @db.Text
  price       Decimal     @db.Decimal(10, 2)
  specs       Json?
  stock       Int         @default(-1) // -1 = unlimited
  active      Boolean     @default(true)
  featured    Boolean     @default(false)
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders Order[]
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  serviceId  String
  status     OrderStatus @default(PENDING)
  config     Json?
  totalPrice Decimal     @db.Decimal(10, 2)
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  vpnConfigs    VpnConfig[]
  proxyAccounts ProxyAccount[]
  emailAccounts EmailAccount[]
  vpsInstances  VpsInstance[]

  @@index([userId])
  @@index([serviceId])
}

model VpnConfig {
  id             String   @id @default(cuid())
  userId         String
  orderId        String
  protocol       String   // wireguard, openvpn, ikev2
  serverLocation String
  configData     String   @db.LongText // encrypted config file content
  expiresAt      DateTime
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
}

model ProxyAccount {
  id       String  @id @default(cuid())
  userId   String
  orderId  String
  protocol String  // http, socks5, residential
  location String  // country code
  host     String
  port     Int
  username String
  password String
  active   Boolean @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([location])
}

model EmailAccount {
  id           String   @id @default(cuid())
  userId       String
  orderId      String
  domain       String
  emailAddress String
  serverType   String   // postfix, exchange
  status       String   @default("active")
  createdAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
}

// ─── VPS Instance (Proxmox VM Assignment) ───────────────────────

model VpsInstance {
  id             String    @id @default(cuid())
  userId         String
  orderId        String
  vmId           String    // Proxmox VM ID (e.g., "104")
  node           String    // Proxmox node name (e.g., "pve-01")
  name           String    // Display name (e.g., "My Windows VPS")
  os             String    // OS label (e.g., "Windows 11 23H2")
  status         String    @default("stopped") // running, stopped, provisioning
  displayType    String    @default("novnc")   // novnc | spice
  specs          Json?     // {vcpu, ram_gb, disk_gb, gpu}
  ipAddress      String?
  expiresAt      DateTime?
  ticketId       String?   @unique  // Links to DeploymentTicket
  gpuNodeId      String?            // Links to GpuNode (null = no GPU)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order             @relation(fields: [orderId], references: [id])
  ticket        DeploymentTicket?  @relation(fields: [ticketId], references: [id])
  gpuNode       GpuNode?           @relation(fields: [gpuNodeId], references: [id], onDelete: Restrict)
  blockStorage  VmBlockStorageAddon[]
  vpcAssignment VpcAssignment?

  @@unique([vmId, node])
  @@index([userId])
  @@index([gpuNodeId])
}

// ─── GPU Node Inventory ──────────────────────────────────────────

/// Tracks physical GPU hardware available for PCIe passthrough.
/// usedVram is incremented/decremented atomically via Prisma transactions
/// to prevent over-provisioning across concurrent requests.
model GpuNode {
  id         String      @id @default(cuid())
  pciAddress String      @unique // e.g. "0000:03:00.0" or "0000:81:00.0"
  label      String?              // human-readable name e.g. "TU106-GPU1-6GB"
  totalVram  Int                  // allocatable VRAM in GB
  usedVram   Int         @default(0)
  maxVms     Int                  // hard cap (e.g. 1 for 6GB GPU, 3 for 12GB)
  active     Boolean     @default(true)  // set false to drain without deleting
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  vms VpsInstance[]

  @@index([active])
}

// ─── Phase 1: Proxmox VM Block Storage Addons ──────────────────────

/// Tracks extra Proxmox block disk volumes attached to a specific VM.
/// Provisioned via Proxmox API (equivalent to `qm set <vmid> --scsiN pool:sizeG`).
/// Pricing: NVME 2000 VND/GB • SATA 1200 VND/GB • HDD 350 VND/GB
model VmBlockStorageAddon {
  id            String   @id @default(cuid())
  vpsInstanceId String
  storagePool   String   // Proxmox pool name e.g. "SSD-NVME-2TB", "local-zfs"
  storageType   String   // "nvme" | "sata" | "hdd" (tier classification)
  diskSlot      String   // e.g. "sata1", "scsi1" (bus:index assigned)
  sizeGb        Int      // GB attached in this transaction
  pricePerGb    Int      // VND/GB snapshot at purchase time
  totalCost     Int      // sizeGb × pricePerGb
  active        Boolean  @default(true)
  purchasedAt   DateTime @default(now())

  vpsInstance VpsInstance @relation(fields: [vpsInstanceId], references: [id], onDelete: Cascade)

  @@index([vpsInstanceId])
}

// ─── Per-Customer Virtual Private Cloud ──────────────────────────

/// Tracks isolated VPC networks with per-customer VLANs (501-1000).
/// Each VPC maps to a Proxmox SDN VNet and a MikroTik VLAN interface.
/// /28 subnets provide 14 usable IPs per customer.
/// Users can self-provision up to maxVpcs (default 3, max 5).
model Vpc {
  id              String      @id @default(cuid())
  userId          String?     // Owner — null for legacy admin-created VPCs
  name            String      // User-chosen display name
  vlanId          Int         @unique  // 501-1000
  vnetName        String      @unique  // Proxmox SDN VNet tag: "vc501"
  zoneName        String      @default("NRSPVC")  // Proxmox SDN Zone (VXLAN)
  mikrotikVlanIf  String?     // MikroTik VLAN interface name (auto-created)
  subnet          String      // "10.50.1.0/28"
  gateway         String      // "10.50.1.1"
  dhcpStart       String?     // "10.50.1.2"
  dhcpEnd         String?     // "10.50.1.14"
  isolate         Boolean     @default(true)  // Proxmox "Isolate Ports"
  status          String      @default("ACTIVE")  // ACTIVE | DISABLED
  description     String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments VpcAssignment[]

  @@index([userId])
  @@index([vlanId])
  @@index([status])
}

/// Links a VPS instance to a VPC. 1:1 relationship — each VM
/// belongs to at most one VPC at a time.
model VpcAssignment {
  id             String      @id @default(cuid())
  vpcId          String
  vpsInstanceId  String      @unique  // 1:1 — one VM per VPC assignment
  bridgeName     String      // Proxmox bridge assigned (e.g. "vc001")
  ipAddress      String?     // Static IP within subnet
  assignedAt     DateTime    @default(now())

  vpc         Vpc         @relation(fields: [vpcId], references: [id], onDelete: Cascade)
  vpsInstance VpsInstance  @relation(fields: [vpsInstanceId], references: [id], onDelete: Cascade)

  @@index([vpcId])
}

// ─── Website-Managed WireGuard Peers ─────────────────────────────

/// Tracks WireGuard peers created via the website dashboard.
/// Peers are pushed to the MikroTik Customers-WG1 interface.
/// Each user can have up to 3 active peers (phone, laptop, desktop).
/// Remote-WG1 is never managed by the website.
model WgPeer {
  id              String    @id @default(cuid())
  userId          String
  name            String                   // "My Laptop", "iPhone"
  publicKey       String    @unique        // Client WG public key
  presharedKey    String?   @db.Text       // Optional PSK
  assignedIp      String    @unique        // 10.98.0.x
  allowedSubnets  String    @db.Text       // JSON: ["10.50.1.0/28"]
  mikrotikPeerId  String?                  // MikroTik .id for deletion
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Phase 2: Per-User Nextcloud Cloud Storage ─────────────────────

/// One record per user. Tracks their Nextcloud cloud storage quota.
/// Rules:
///   - 5 GB free base (granted when first eligible VM is provisioned)
///   - Paid expansion: must be in 5 GB increments (5, 10, 15 … 95 GB extra)
///   - Hard cap: 100 GB total (5 GB free + up to 95 GB paid)
///   - Prerequisite: user must have ≥1 active VpsInstance (min. Nano-NAT tier)
model UserNextcloudStorage {
  id            String   @id @default(cuid())
  userId        String   @unique
  ncUsername    String   @unique // NC account name; convention: "user-<userId[0..7]>"
  freeGb        Int      @default(5)  // base free tier
  paidGb        Int      @default(0)  // total paid expansion GB
  totalGb       Int      @default(5)  // freeGb + paidGb (denormalised for fast reads)
  active        Boolean  @default(true)
  provisionedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ncUsername])
}

// ─── CMS Models ─────────────────────────────────────────────────

enum CmsType {
  NEWS
  BLOG
}

model CmsPost {
  id         String   @id @default(cuid())
  type       CmsType
  title      String
  slug       String   @unique
  excerpt    String?  @db.Text
  content    String   @db.LongText
  coverImage String?
  published  Boolean  @default(false)
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([published, type])
}

model FaqEntry {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.LongText
  category  String   @default("General")
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, category])
}

// ─── User Manual Models ─────────────────────────────────────────

model ManualChapter {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  ManualSection[]

  @@index([published, sortOrder])
}

model ManualSection {
  id         String   @id @default(cuid())
  chapterId  String
  parentId   String?
  title      String
  slug       String
  content    String   @db.LongText
  sortOrder  Int      @default(0)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chapter    ManualChapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  parent     ManualSection? @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   ManualSection[] @relation("SectionTree")

  @@unique([chapterId, slug])
  @@index([chapterId, sortOrder])
  @@index([parentId])
}

// ─── File Upload Registry ───────────────────────────────────

enum UploadContext {
  TICKET
  CHAT
  AVATAR
  MMO_ITEM
  CMS_COVER
}

model FileUpload {
  id           String        @id @default(cuid())
  context      UploadContext
  originalName String
  storedName   String        @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploaderId   String
  createdAt    DateTime      @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([sha256])
  @@index([context])
}

// ─── Billing & Transactions ────────────────────────────────

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  method    String   @default("dev_bypass") // btc, eth, dev_bypass
  status    String   @default("paid")       // paid, pending, failed
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── ISO 27001 A.12.4 — Immutable Audit Logging ─────────────────

enum AuditAction {
  // Auth
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ACCOUNT_CREATED
  TFA_ENABLED
  TFA_DISABLED
  PASSWORD_CHANGED
  SESSION_REVOKED
  // VM Lifecycle
  VM_CREATE
  VM_START
  VM_STOP
  VM_REBOOT
  VM_DESTROY
  VM_REINSTALL
  VM_DISPLAY_CHANGE
  VM_GPU_ALLOCATE
  VM_GPU_RELEASE
  // Console Access
  CONSOLE_VNC_ACCESS
  CONSOLE_SPICE_ACCESS
  // Billing
  CREDIT_TOPUP
  CREDIT_DEDUCTION
  PROMO_APPLIED
  PLAN_ACTIVATED
  STORAGE_PURCHASE
  // Orchestration
  SNAPSHOT_CREATE
  SNAPSHOT_DELETE
  SNAPSHOT_ROLLBACK
  BACKUP_CREATE
  // Admin
  ADMIN_USER_MODIFY
  ADMIN_VM_ASSIGN
  ADMIN_VM_MODIFY
  ADMIN_PASSWORD_RESET
  ADMIN_PRICING_CHANGE
  // Data
  DATA_EXPORT
  DATA_DELETION_REQUEST
  USER_ANONYMIZED
  // Security
  SSH_KEY_ADD
  SSH_KEY_REMOVE
  // Crypto Payments
  CRYPTO_TOPUP_INITIATED
  CRYPTO_TOPUP_COMPLETED
  // Invitation System
  INVITE_CODE_GENERATED
  INVITE_CODE_REDEEMED
  INVITE_PERMISSION_CHANGED
  // Chat
  ADMIN_CHAT_CLOSED
  ADMIN_PIN_RESET
  ADMIN_CHAT_KEY_SETUP
  USER_CHAT_PIN_RESET
  // VPC / Network
  VPC_CREATE
  VPC_DELETE
  VPC_ASSIGN_VM
  VPC_UNASSIGN_VM
  // WireGuard
  WG_PEER_CREATE
  WG_PEER_REVOKE
  // Misc
  REDIRECT_TO_PLANS
  TRIGGER_UPSELL_FLOW
}

model AuditLog {
  id             String      @id @default(cuid())
  userId         String
  action         AuditAction
  resourceType   String      // "VirtualMachine", "UserAccount", "Network", "Billing"
  resourceId     String?     // ID of the target resource (vmId, orderId, etc.)
  ipAddress      String?
  userAgent      String?
  metadata       Json?       // Payload diffs, extra context
  outcome        String      @default("SUCCESS") // "SUCCESS" | "FAILED" | "DENIED"
  createdAt      DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ─── Credit Wallet ────────────────────────────────────────────────

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "Top-up", "VM_Deduction", "Promo_Redeem"
  amount    Int      // positive = credit, negative = deduction
  details   String?  // e.g. "VM#101 Deduction", "Promo: LAUNCH25"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  creditValue  Int
  maxUses      Int       @default(1)
  currentUses  Int       @default(0)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  appliedToUsers AppliedPromoCode[]
}

model AppliedPromoCode {
  id          String   @id @default(cuid())
  userId      String
  promoCodeId String
  appliedAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])

  @@unique([userId, promoCodeId])
  @@index([userId])
}

// ─── Deployment Ticket System ─────────────────────────────────────

model DeploymentTicket {
  id         String    @id @default(cuid())
  userId     String
  planId     String    // e.g., "Dev-Standard", "Perform-NVMe"
  status     String    @default("AVAILABLE") // "AVAILABLE" | "IN_USE"
  validUntil DateTime
  createdAt  DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpsInstance VpsInstance? // populated when status = "IN_USE"

  @@index([userId])
  @@index([status])
}

// ─── MMO Digital Asset Storefront ────────────────────────────────

/// A category of digital products (e.g., "Netflix Accounts", "Gmail Aged")
/// `schema` stores pipe-delimited field names that define each item's structure.
model MmoProductCategory {
  id           String   @id @default(cuid())
  slug         String   @unique          // URL-safe: "netflix-premium"
  name         String                    // Display: "Netflix Premium Accounts"
  description  String?  @db.Text
  imageUrl     String?                   // Product card image URL
  schema       String   @db.Text         // "email|password|recovery|2fa"
  pricePerUnit Int                       // price in Credits per unit
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items MmoInventoryItem[]

  @@index([active])
}

/// Individual inventory records stocked by Admin.
/// `data` stores pipe-delimited values matching the category schema.
/// 30-day retention: data is viewable until expiresAt, then purged.
model MmoInventoryItem {
  id         String    @id @default(cuid())
  categoryId String
  data       String    @db.Text         // "user@ex.com|Pass123!|recov@x.com|TOTP"
  sold       Boolean   @default(false)
  soldAt     DateTime?
  soldToId   String?                    // userId of buyer (null = unsold)
  expiresAt  DateTime?                  // soldAt + 30 days; null = unsold
  createdAt  DateTime  @default(now())

  category MmoProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sold])
  @@index([soldToId])
  @@index([expiresAt])
}

// ─── Secure E2EE Support Chat ────────────────────────────────────

// ─── Secure E2EE Support Chat ────────────────────────────────────

/// Per-user encrypted chat thread for admin support.
/// Uses ECDH P-256 key agreement: user + admin each have a keypair.
/// Private keys are stored encrypted with their respective PINs.
/// PINs are local UI locks only — NOT the message encryption key.
model SupportChat {
  id              String    @id @default(cuid())
  userId          String
  userPubKey      String    @db.Text    // User's ECDH public key (JWK JSON)
  userEncPrivKey  String    @db.Text    // User's private key encrypted with user PIN (base64)
  userKeyIv       String                // IV used to encrypt user's private key (base64)
  pinHash         String                // bcrypt hash of user-chosen PIN
  closed          Boolean   @default(false)
  closedAt        DateTime?             // Timestamp when permanently closed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@unique([userId])                    // one active chat per user
  @@index([userId])
}

/// Individual encrypted messages within a support chat.
/// `ciphertext` is AES-GCM encrypted payload (base64).
/// `iv` is the initialization vector used for AES-GCM (base64).
/// `senderType` distinguishes USER vs ADMIN messages.
model SupportMessage {
  id         String   @id @default(cuid())
  chatId     String
  senderType String                    // "USER" | "ADMIN"
  ciphertext String   @db.Text        // AES-GCM encrypted message (base64)
  iv         String                    // AES-GCM IV (base64)
  createdAt  DateTime @default(now())

  chat SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

// ─── Global Ticket System ────────────────────────────────────────

enum TicketStatus {
  PENDING
  UNSOLVED
  SOLVED
}

/// Platform-wide support tickets. Supports markdown descriptions
/// and secure image evidence uploads. Viewable only by the
/// creator and platform administrators.
model Ticket {
  id          String       @id @default(cuid())
  userId      String
  title       String       @db.VarChar(200)
  description String       @db.Text           // Markdown body
  imageUrls   String?      @db.Text           // JSON array of upload paths
  status      TicketStatus @default(PENDING)
  priority    String       @default("medium") // low | medium | high | critical
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications TicketNotification[]

  @@index([userId, status])
  @@index([status, createdAt])
}

/// In-app notification sent when an admin changes a ticket to SOLVED.
model TicketNotification {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String   // The ticket creator who receives the notification
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([ticketId])
}

/// Global platform configuration key-value store.
/// Used by the admin System Settings panel.
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── Crypto Top-up (Shkeeper.io USDT Gateway) ────────────────────

/// Tracks each crypto top-up request lifecycle.
/// HD wallet derivation ensures every address is unique and non-reusable.
model CryptoTopup {
  id              String    @id @default(cuid())
  userId          String
  amountUsdt      Decimal   @db.Decimal(12, 6)
  creditAmount    Int       // Calculated credits to mint (amountUsdt * exchange rate)
  chain           String    // "TRC20" | "ERC20"
  depositAddress  String    // Unique HD-derived address for this top-up
  derivationIndex Int       // HD wallet derivation path index
  txHash          String?   // Blockchain transaction hash (set on confirmation)
  confirmations   Int       @default(0)
  status          String    @default("PENDING") // PENDING | CONFIRMING | COMPLETED | EXPIRED
  expiresAt       DateTime  // Address validity window (e.g., 30 minutes)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([depositAddress])
  @@index([status])
}

// ─── Invitation Code System ──────────────────────────────────────

/// User-generated invitation codes for trial access.
/// Only users with canInvite = true can generate codes.
/// Each code supports up to maxUses redemptions (default 10).
model InvitationCode {
  id          String    @id @default(cuid())
  code        String    @unique            // Format: "NRSP-XXXX-XXXX"
  creatorId   String                       // User who generated the code
  maxUses     Int       @default(10)       // Max redemptions per code
  usedCount   Int       @default(0)        // Current redemption count
  expiresAt   DateTime?                    // Optional expiry
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  creator     User      @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  redemptions InvitationRedemption[]

  @@index([code])
  @@index([creatorId])
}

/// Tracks each individual redemption of an invitation code.
model InvitationRedemption {
  id               String   @id @default(cuid())
  invitationCodeId String
  userId           String                  // User who redeemed the code
  redeemedAt       DateTime @default(now())
  context          String   @default("REGISTRATION") // "REGISTRATION" | "CHECKOUT"

  invitationCode   InvitationCode @relation(fields: [invitationCodeId], references: [id], onDelete: Cascade)

  @@unique([invitationCodeId, userId])    // One redemption per user per code
  @@index([userId])
}
